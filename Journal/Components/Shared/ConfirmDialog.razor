<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@CancelText</MudButton>
        <MudButton Color="Color" Variant="Variant.Outlined" OnClick="Confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>
