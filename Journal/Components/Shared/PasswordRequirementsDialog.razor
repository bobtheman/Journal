<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Password requirements</MudText>
    </TitleContent>
    <DialogContent>
        <MudList T="string" ReadOnly="true" Dense="true">
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check">At least 8 characters</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check">An uppercase letter</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check">A lowercase letter</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check">A number</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check">A special character</MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>


