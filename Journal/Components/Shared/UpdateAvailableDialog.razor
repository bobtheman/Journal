@using Journal.Models
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Update available</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-2">Version @Update.Version is available.</MudText>
        @if (!string.IsNullOrWhiteSpace(Update.ReleaseNotes))
        {
            <MudText Typo="Typo.body2" Class="update-release-notes">@Update.ReleaseNotes</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm">Download</MudButton>
    </DialogActions>
</MudDialog>
