@page "/"
@using Journal.Components.Shared

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled" OnClick="AddEntryAsync" />
</MudStack>

@if (_summaries.Count == 0)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-4" Spacing="3">
        <MudText Typo="Typo.body2" Class="mud-text-secondary" Align="Align.Center">No entries yet.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddEntryAsync">Write your first entry</MudButton>
    </MudStack>
}
else
{
    string? lastPeriod = null;

    <MudList T="DateTime" Dense="true" Class="journal-list">
        @foreach (var summary in _summaries)
        {
            var period = summary.EntryDate.ToString("MMMM yyyy");
            if (period != lastPeriod)
            {
                lastPeriod = period;
                <MudListSubheader Class="journal-month-header">@period</MudListSubheader>
            }
            <MudListItem T="DateTime" OnClick="@(() => OpenEntryAsync(summary.EntryDate))" Class="journal-entry-item">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="journal-day-badge">@summary.EntryDate.ToString("dd/MM/yyyy")</MudText>
                        <MudText Typo="Typo.body1">@(summary.Title == string.Empty ? summary.EntryDate.ToString("d MMM yyyy") : summary.Title)</MudText>
                    </MudStack>
                    @if (summary.Mood.HasValue)
                    {
                        <MudIcon Icon="@MoodIcons.GetIcon(summary.Mood.Value)" Color="@MoodIcons.GetColor(summary.Mood.Value)"
                                 Style="@(MoodIcons.GetHex(summary.Mood.Value) is { } hex ? $"color:{hex}" : null)" Size="Size.Small" />
                    }
                </MudStack>
            </MudListItem>
        }
    </MudList>
}
