@page "/settings"
@using Journal.Services

<MudText Typo="Typo.h4" Class="mb-4">Settings</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Appearance</MudText>
    <MudSelect T="ThemeMode" Value="_themeMode" ValueChanged="OnThemeModeChanged" Label="Theme" Variant="Variant.Outlined">
        <MudSelectItem Value="ThemeMode.System">Use device setting</MudSelectItem>
        <MudSelectItem Value="ThemeMode.Light">Light</MudSelectItem>
        <MudSelectItem Value="ThemeMode.Dark">Dark</MudSelectItem>
    </MudSelect>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Google Drive backup</MudText>

    @if (_signedIn)
    {
        <MudText Typo="Typo.body2" Class="mb-2">Signed in.</MudText>
        <MudSwitch T="bool" Value="_autoSync" ValueChanged="OnAutoSyncChanged" Color="Color.Primary" Label="Auto backup" />
        @if (_autoSync)
        {
            <MudSwitch T="bool" Value="_backupNotifications" ValueChanged="OnBackupNotificationsChanged" Color="Color.Primary" Label="Notify when backup completes" />
        }
        <MudText Typo="Typo.caption" Class="d-block mb-3">
            Last synced: @(SettingsService.LastSyncUtc?.ToLocalTime().ToString("g") ?? "never")
        </MudText>
        <MudStack Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="BackupAsync" Disabled="_busy">Backup now</MudButton>
            <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="RestoreAsync" Disabled="_busy">Restore latest</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" OnClick="SignOutAsync" Disabled="_busy">Sign out</MudButton>
        </MudStack>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SignInAsync" Disabled="_busy">
            Sign in with Google
        </MudButton>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
        <MudText Typo="Typo.caption" Class="mt-2 d-block">@_status</MudText>
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Change password</MudText>
    <MudTextField T="string" Label="Current password" @bind-Value="_oldPassword"
                  InputType="@(_showOldPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(_showOldPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                  OnAdornmentClick="@(() => _showOldPassword = !_showOldPassword)"
                  Class="mb-2" />
    <MudTextField T="string" Label="New password" @bind-Value="_newPassword"
                  InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                  OnAdornmentClick="@(() => _showNewPassword = !_showNewPassword)"
                  HelperText="At least 8 characters, with upper, lower, number and special character."
                  Class="mb-2" />
    @if (!string.IsNullOrEmpty(_passwordError))
    {
        <MudAlert Severity="Severity.Error" Class="mb-2">@_passwordError</MudAlert>
    }
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="ChangePasswordAsync">Update password</MudButton>
</MudPaper>

@if (_biometricHwAvailable)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Fingerprint unlock</MudText>
        <MudSwitch T="bool" Value="_biometricEnabled" ValueChanged="OnBiometricSwitchChanged" Color="Color.Primary" Label="Unlock with fingerprint" />

        @if (_showBiometricPasswordPrompt)
        {
            <MudTextField T="string" Label="Confirm current password" @bind-Value="_biometricPassword"
                          InputType="@(_showBiometricPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showBiometricPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showBiometricPassword = !_showBiometricPassword)"
                          Class="mt-2 mb-2" Immediate="true" OnKeyUp="OnBiometricPasswordKeyUp" />
            <MudStack Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="ConfirmEnableBiometricAsync">Confirm</MudButton>
                <MudButton Variant="Variant.Text" FullWidth="true" OnClick="CancelEnableBiometric">Cancel</MudButton>
            </MudStack>
        }

        @if (!string.IsNullOrEmpty(_biometricError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_biometricError</MudAlert>
        }
    </MudPaper>
}

<MudPaper Class="pa-4 mt-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Account</MudText>
    <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout">Log out</MudButton>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Danger zone</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">Permanently delete every journal entry on this device. This cannot be undone.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" OnClick="DeleteAllDataAsync" Disabled="_busy">Delete all data</MudButton>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">App update</MudText>
    <MudText Typo="Typo.caption" Class="d-block mb-3">
        Current version: v@(AppInfo.Current.VersionString) (@AppInfo.Current.BuildString)
    </MudText>

    @if (_updateAvailable is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-2">Version @_updateAvailable.Version is available.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="InstallUpdateAsync" Disabled="_updateBusy">
            @(_updateBusy ? $"Downloading... {_downloadProgress:P0}" : "Download and install")
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="CheckForUpdateAsync" Disabled="_updateBusy">
            @(_updateBusy ? "Checking..." : "Check for updates")
        </MudButton>
    }

    @if (!string.IsNullOrEmpty(_updateStatus))
    {
        <MudText Typo="Typo.caption" Class="mt-2 d-block">@_updateStatus</MudText>
    }
</MudPaper>
